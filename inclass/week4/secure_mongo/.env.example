# Copy this file to .env and replace the placeholders. Never commit .env to GitHub.
#
# Get the string from Atlas: Connect -> Drivers -> Python -> copy the connection string.
# Then (1) replace <password> with your database user's password, and
#      (2) add a database name right after ".mongodb.net/", before the "?".
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/week4_demo?retryWrites=true&w=majority
